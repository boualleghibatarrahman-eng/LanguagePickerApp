<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3E0"
    tools:context=".MultipleChoiceActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_choose_multiple"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#E65100"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp" />

        <CheckBox
            android:id="@+id/checkJava"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lang_java"
            android:textSize="18sp"
            android:padding="12dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/titleText"
            app:layout_constraintStart_toStartOf="parent" />

        <CheckBox
            android:id="@+id/checkJavaScript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lang_javascript"
            android:textSize="18sp"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/checkJava"
            app:layout_constraintStart_toStartOf="parent" />

        <CheckBox
            android:id="@+id/checkDart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lang_dart"
            android:textSize="18sp"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/checkJavaScript"
            app:layout_constraintStart_toStartOf="parent" />

        <CheckBox
            android:id="@+id/checkPython"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lang_python"
            android:textSize="18sp"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/checkDart"
            app:layout_constraintStart_toStartOf="parent" />

        <CheckBox
            android:id="@+id/checkCSharp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lang_csharp"
            android:textSize="18sp"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/checkPython"
            app:layout_constraintStart_toStartOf="parent" />

        <CheckBox
            android:id="@+id/checkCpp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lang_cpp"
            android:textSize="18sp"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/checkCSharp"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/confirmMultipleBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_confirm"
            android:backgroundTint="#FF9800"
            android:textColor="@color/white"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/checkCpp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>